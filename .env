# Server Configuration
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/seven_star_printing
MONGODB_URI_PROD=mongodb+srv://username:password@cluster.mongodb.net/seven_star_printing

# JWT
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
JWT_EXPIRE=7d

# Admin Credentials (change in production)
ADMIN_EMAIL=admin@sevenstarpress.pk
ADMIN_PASSWORD=SevenStar@2025Admin

# Email Configuration (for Nodemailer)
EMAIL_USER=hello@sevenstarpress.pk
EMAIL_PASS=your_email_app_password
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587

# File Upload
MAX_FILE_SIZE=20971520 # 20MB
UPLOAD_PATH=./uploads

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173

# WhatsApp (for contact page)
WHATSAPP_NUMBER=923001234567